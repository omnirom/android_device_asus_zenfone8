# All com.asus.gallery to read the hdr_mode drm path
allow platform_app vendor_sysfs_graphics:file r_file_perms;

allow platform_app vendor_camera_prop:file { getattr map open read };
allow platform_app vendor_asus_build_prop:file { getattr map open read };

# for system/lib64/DataSet/ispDB/ParameterDB.db
allow platform_app system_lib_file:file lock;

get_prop(platform_app, vendor_asus_prop)
get_prop(platform_app, vendor_asus_camera_prop)
get_prop(platform_app, vendor_asus_sp_system_prop)